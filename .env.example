# Optional environment overrides. Copy to `.env` (the app reads it at start-up).
# Real environment variables always win over values in .env.

# Use a different configuration file
# GESTURE_CONFIG_PATH=config/config.yaml

# Override logging level: DEBUG, INFO, WARNING, ERROR
# GESTURE_LOG_LEVEL=INFO

# Override the screenshot directory (relative paths are relative to the project root)
# GESTURE_SCREENSHOT_DIR=screenshots
